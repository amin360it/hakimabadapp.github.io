        </div>
        <div class="absolute top-0 left-0 right-0 h-32 bg-gradient-to-b from-black/30 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 h-48 bg-gradient-to-t from-[#072D1E] to-transparent"></div>
        <div class="relative z-10 text-center px-4 max-w-5xl mx-auto py-20">
