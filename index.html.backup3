            <div class="inline-block bg-white/[0.07] backdrop-blur-md rounded-2xl border border-secondary/30 p-4 md:p-5 shadow-[0_0_30px_rgba(201,162,39,0.15)]">
              <img src="./assets/images/bismillah gradient.webp" alt="Bismillah" class="w-25 h-auto mx-auto drop-shadow-[0_0_10px_rgba(201,162,39,0.2)]">
