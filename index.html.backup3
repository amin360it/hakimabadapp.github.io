          <div class="animate-fade-up animate-delay-2 mt-10">
            <div class="inline-flex items-center gap-2 px-5 py-2 bg-black/20 backdrop-blur-md rounded-full text-secondary-light text-sm font-medium mb-6 border border-white/10 tracking-wide">
